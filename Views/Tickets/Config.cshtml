@{
    ViewData["Title"] = "Configuración de Reglas";
}

<div class="container mt-4">
    <h2>Configuración de Reglas de Impresión</h2>

    <div class="mb-3">
        <button class="btn btn-primary" onclick="agregarRegla()">
            + Nueva Regla
        </button>

        <button class="btn btn-success" onclick="guardarReglas()">
            Guardar Cambios
        </button>
    </div>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Prioridad</th>
                <th>Nombre</th>
                <th>Campo</th>
                <th>Contiene Texto</th>
                <th>Color</th>
                <th>Impresora</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="tablaReglas"></tbody>
    </table>

    <div id="statusMsg"></div>
</div>

<script>
    let reglas = [];
    let impresoras = [];

    document.addEventListener("DOMContentLoaded", async function () {
        await cargarImpresoras();
        await cargarReglas();
    });

    async function cargarImpresoras() {
        const res = await fetch('/Tickets/GetInstalledPrinters');
        impresoras = await res.json();
    }

    async function cargarReglas() {
        const res = await fetch('/Tickets/GetTicketRules');
        reglas = await res.json() || [];

        reglas.sort((a, b) => (a.prioridad || 99) - (b.prioridad || 99));

        renderTabla();
    }

    function renderTabla() {
        const tbody = document.getElementById("tablaReglas");
        tbody.innerHTML = "";

        reglas.forEach((r, index) => {

            let opcionesImpresora = impresoras.map(p =>
                `<option value="${p}" ${p === r.impresora ? "selected" : ""}>
                    ${p}
                 </option>`
            ).join("");

            const row = `
                <tr>
                    <td>
                        <input type="number" min="1" class="form-control"
                               value="${r.prioridad ?? 99}"
                               onchange="reglas[${index}].prioridad=parseInt(this.value)||99">
                    </td>
                    <td>
                        <input class="form-control"
                               value="${r.nombreRegla ?? ''}"
                               onchange="reglas[${index}].nombreRegla=this.value">
                    </td>
                    <td>
                        <select class="form-select"
                                onchange="reglas[${index}].campo=this.value">
                            <option value="Hotel" ${r.campo === "Hotel" ? "selected" : ""}>Hotel</option>
                            <option value="Tipo" ${r.campo === "Tipo" ? "selected" : ""}>Tipo</option>
                            <option value="Habitacion" ${r.campo === "Habitacion" ? "selected" : ""}>Habitacion</option>

                        </select>
                    </td>
                    <td>
                        <input class="form-control"
                               value="${r.contieneTexto ?? ''}"
                               onchange="reglas[${index}].contieneTexto=this.value">
                    </td>
                    <td>
                        <input type="color"
                               value="${r.colorHex ?? '#ffffff'}"
                               onchange="reglas[${index}].colorHex=this.value">
                    </td>
                    <td>
                        <select class="form-select"
                                onchange="reglas[${index}].impresora=this.value">
                            ${opcionesImpresora}
                        </select>
                    </td>
                    <td>
                        <button class="btn btn-danger btn-sm"
                                onclick="eliminarRegla(${index})">
                            X
                        </button>
                    </td>
                </tr>
            `;

            tbody.innerHTML += row;
        });
    }

    function agregarRegla() {

        let maxPrioridad = reglas.length > 0
            ? Math.max(...reglas.map(r => r.prioridad || 0))
            : 0;

        reglas.push({
            prioridad: maxPrioridad + 1,
            nombreRegla: "",
            campo: "Hotel",
            contieneTexto: "",
            colorHex: "#ffffff",
            impresora: impresoras.length > 0 ? impresoras[0] : ""
        });

        renderTabla();
    }

    function eliminarRegla(index) {
        reglas.splice(index, 1);
        renderTabla();
    }

    async function guardarReglas() {

        for (let r of reglas) {
            if (!r.prioridad || r.prioridad < 1) {
                alert("Todas las reglas deben tener prioridad mayor a 0");
                return;
            }
        }

        const res = await fetch('/Tickets/SaveTicketRules', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(reglas)
        });

        if (res.ok) {
            document.getElementById("statusMsg").innerHTML =
                "<span style='color:green'>Reglas guardadas correctamente</span>";
        } else {
            document.getElementById("statusMsg").innerHTML =
                "<span style='color:red'>Error al guardar</span>";
        }
    }
</script>