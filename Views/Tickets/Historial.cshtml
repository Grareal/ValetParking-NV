<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Historial de Tickets  </title>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- DataTables -->
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <!-- Buttons (Exportar Excel) -->
    <link href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <style>
        :root {
            --sv-teal-900: #0D5D63;
            --sv-teal-950: #0A4A4F;
            --sv-teal-500: #13A5A4;
            --sv-teal-100: #E3F2F1;
            --sv-gold-500: #D9A427;
            --sv-gold-600: #BD8B19;
            --sv-gold-100: #FBF1DA;
            --sv-cream: #F7F4EE;
            --sv-ink: #16241F;
            --sv-ink-soft: #4B5C58;
            --sv-line: #E4E1D8;
            --sv-white: #FFFFFF;
            --sv-radius-lg: 16px;
            --sv-radius-md: 10px;
            --sv-radius-sm: 7px;
            --sv-shadow: 0 8px 28px rgba(13, 30, 28, 0.08);
            --sv-shadow-sm: 0 2px 8px rgba(13, 30, 28, 0.06);
        }

        * { box-sizing: border-box; }

        body {
            background: var(--sv-cream);
            font-family: 'Inter', 'Segoe UI', sans-serif;
            color: var(--sv-ink);
            padding: 0;
            margin: 0;
        }

        .sv-shell {
            max-width: 1300px;
            margin: 0 auto;
            padding: 28px 28px 60px;
        }

        .sv-topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 22px;
            flex-wrap: wrap;
            gap: 14px;
        }

        .sv-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sv-brand-mark {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            background: linear-gradient(145deg, var(--sv-teal-900), var(--sv-teal-950));
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--sv-gold-500);
            font-weight: 800;
            font-size: 18px;
            flex-shrink: 0;
            box-shadow: var(--sv-shadow-sm);
        }

        .sv-brand-text .eyebrow {
            font-size: 11px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--sv-teal-500);
            font-weight: 700;
            margin: 0;
        }

        .sv-brand-text h1 {
            font-size: 22px;
            font-weight: 700;
            margin: 1px 0 0;
            color: var(--sv-ink);
            letter-spacing: -0.01em;
        }

        .sv-btn {
            font-family: inherit;
            font-size: 13.5px;
            font-weight: 600;
            border-radius: var(--sv-radius-sm);
            padding: 9px 18px;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.15s ease;
            white-space: nowrap;
        }

        .sv-btn:active { transform: translateY(1px); }

        .sv-btn-ghost {
            background: var(--sv-white);
            color: var(--sv-teal-900);
            border: 1px solid var(--sv-line);
        }

        .sv-btn-ghost:hover {
            border-color: var(--sv-teal-500);
        }

        .sv-btn-gold {
            background: var(--sv-gold-500);
            color: #2a1f04;
        }

        .sv-btn-gold:hover {
            background: var(--sv-gold-600);
            box-shadow: 0 6px 14px rgba(217, 164, 39, 0.35);
        }

        .sv-panel {
            background: var(--sv-white);
            border-radius: var(--sv-radius-lg);
            box-shadow: var(--sv-shadow);
            padding: 22px;
            border: 1px solid var(--sv-line);
        }

        .sv-panel-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--sv-ink);
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
        }

        .sv-panel-title .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--sv-teal-500);
            display: inline-block;
        }

        .filters {
            margin-bottom: 18px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        .filters .field-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--sv-ink-soft);
            font-weight: 700;
            display: block;
            margin-bottom: 4px;
        }

        .field-group { display: flex; flex-direction: column; }

        input {
            font-family: inherit;
            padding: 9px 12px;
            border-radius: var(--sv-radius-sm);
            border: 1px solid var(--sv-line);
            font-size: 13.5px;
            background: var(--sv-cream);
            color: var(--sv-ink);
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
            margin: 0;
        }

        input::placeholder { color: #93A29D; }

        input:focus {
            border-color: var(--sv-teal-500);
            box-shadow: 0 0 0 3px rgba(19, 165, 164, 0.14);
            background: var(--sv-white);
        }

        #busqueda { width: 320px; }

        /* DataTables overrides */
        table.dataTable {
            border-collapse: collapse !important;
            width: 100% !important;
        }

        table.dataTable thead th {
            background: var(--sv-teal-900);
            color: var(--sv-white);
            font-weight: 600;
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 13px 14px !important;
            border-bottom: none !important;
        }

        table.dataTable tbody td {
            padding: 12px 14px !important;
            font-size: 13.5px;
            border-bottom: 1px solid var(--sv-line) !important;
        }

        table.dataTable tbody tr:hover {
            background: var(--sv-teal-100) !important;
        }

        table.dataTable.no-footer {
            border-bottom: none !important;
        }

        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            font-size: 13px;
            color: var(--sv-ink-soft);
            padding-top: 14px;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            border-radius: 6px !important;
            border: 1px solid var(--sv-line) !important;
            padding: 5px 11px !important;
            margin-left: 4px;
            background: var(--sv-white) !important;
            color: var(--sv-ink) !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: var(--sv-teal-900) !important;
            border-color: var(--sv-teal-900) !important;
            color: var(--sv-white) !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: var(--sv-teal-100) !important;
            border-color: var(--sv-teal-500) !important;
            color: var(--sv-ink) !important;
        }

        .dataTables_wrapper .dataTables_processing {
            color: var(--sv-teal-900);
            font-weight: 600;
        }

        .sv-table-scroll {
            overflow-x: auto;
            border-radius: var(--sv-radius-md);
            border: 1px solid var(--sv-line);
        }

        @@media (max-width: 768px) {
            .sv-shell { padding: 16px 14px 50px; }
            #busqueda { width: 100%; }
            .filters { flex-direction: column; align-items: stretch; }
        }
    </style>
</head>

<body>

    <div class="sv-shell">

        <div class="sv-topbar">
            <div class="sv-brand">
                <div class="sv-brand-mark">SV</div>
                <div class="sv-brand-text">
                    <p class="eyebrow">Smart Valet · Operaciones</p>
                    <h1>Historial de Tickets</h1>
                </div>
            </div>

            <div>
                <button class="sv-btn sv-btn-ghost" onclick="window.location.href='/Tickets/Reservas'">← Volver a Reservas</button>
            </div>
        </div>

        <div class="sv-panel">

            <div class="sv-panel-title"><span class="dot"></span> Tickets enviados</div>

            <div class="filters">

                <div class="field-group" style="flex:1">
                    <label class="field-label">Buscar</label>
                    <input type="text" id="busqueda" placeholder="Confirmation No, nombre, habitación o comentario">
                </div>

                <div class="field-group">
                    <label class="field-label">Desde</label>
                    <input type="date" id="fechaInicio">
                </div>

                <div class="field-group">
                    <label class="field-label">Hasta</label>
                    <input type="date" id="fechaFin">
                </div>

                <div class="field-group">
                    <label class="field-label" style="visibility:hidden">Acción</label>
                    <button class="sv-btn sv-btn-gold" id="exportar">⬇ Descargar Excel</button>
                </div>

            </div>

            <div class="sv-table-scroll">
                <table id="tabla" class="display" style="width:100%">
                    <thead>
                        <tr>
                            <th>Reserva</th>
                            <th>Nombre</th>
                            <th>Habitación</th>
                            <th>Comentario</th>
                            <th>Hotel</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                </table>
            </div>

        </div>

    </div>

    <script>



        // 📅 FECHA POR DEFECTO = HOY
        const hoy = new Date().toISOString().split('T')[0];
        document.getElementById("fechaInicio").value = hoy;
        document.getElementById("fechaFin").value = hoy;

        let tabla = $('#tabla').DataTable({
            processing: true,
            serverSide: true, // 

            ajax: {
                url: '/Tickets/GetTicketsEnviados',
                type: 'POST',
                data: function (d) {
                    d.busqueda = $('#busqueda').val();
                    d.fechaInicio = $('#fechaInicio').val();
                    d.fechaFin = $('#fechaFin').val();
                }
            },
            columns: [
                { data: 'folio' },
                { data: 'nombre' },
                { data: 'habitacion' },
                { data: 'comentario' },
                { data: 'hotel' },
                {
                    data: 'fechaEnvio',
                    render: function (data) {
                        return data ? new Date(data).toLocaleString() : "";
                    }
                }
            ],
            pageLength: 10,
            dom: 'Brtip',
            buttons: [
               
            ],
            language: {
                search: "Buscar:",
                lengthMenu: "Mostrar _MENU_ registros",
                info: "Mostrando _START_ a _END_ de _TOTAL_",
                paginate: {
                    previous: "Anterior",
                    next: "Siguiente"
                }
            }
        });

        let timer;

        $('#busqueda').on('keyup', function () {
            clearTimeout(timer);

            timer = setTimeout(() => {
                tabla.ajax.reload();
            }, 400); // espera 400ms
        });

        $('#fechaInicio, #fechaFin').on('change', function () {
            tabla.ajax.reload();
        });



        // 📤 EXPORTAR TODO (LLAMA AL BACK)
        $('#exportar').click(function () {

            const params = new URLSearchParams({
                busqueda: $('#busqueda').val(),
                fechaInicio: $('#fechaInicio').val(),
                fechaFin: $('#fechaFin').val()
            });

            window.open(
                '/Tickets/ExportarExcel?' + params.toString(),
                '_blank'
            );
        });

    </script>

</body>
</html>
