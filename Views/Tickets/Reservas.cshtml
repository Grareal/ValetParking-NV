@{
    ViewData["Title"] = "Reservas del Día";
}

<style>
    body {
        background: #f4f6f9;
        font-family: 'Segoe UI', sans-serif;
    }

    .card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        padding: 25px;
        margin-top: 25px;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .title {
        font-size: 24px;
        font-weight: 600;
        color: #2c3e50;
    }

    .controls {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    input, select {
        padding: 8px 12px;
        border-radius: 6px;
        border: 1px solid #ddd;
        font-size: 14px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: #2c3e50;
        color: white;
    }

    th, td {
        padding: 12px;
        text-align: left;
        font-size: 14px;
    }

    th {
        cursor: pointer;
    }

    tbody tr {
        transition: 0.2s;
    }

        tbody tr:hover {
            background: #f1f7ff;
        }

    .badge {
        background: #3498db;
        color: white;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
    }

    .btn-print {
        background: #27ae60;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-print:hover {
            background: #219150;
        }

    .status-bar {
        margin-top: 10px;
        font-size: 13px;
        color: #555;
    }
</style>

<div class="card">

    <div class="header">
        <div class="title">Reservas del Día</div>
        <div class="badge" id="contador">0 reservas</div>
    </div>

    <div class="controls">
        <input type="text" id="searchInput" placeholder="Buscar por nombre, folio o habitación...">
        <select id="hotelFilter">
            <option value="">Todos los hoteles</option>
        </select>
        <select id="printerSelect"></select>
    </div>

    <table id="tablaReservas">
        <thead>
            <tr>
                <th onclick="ordenar('h_res_cve')">RESERVA</th>
                <th onclick="ordenar('h_tsw')">C. TSW</th>
                <th onclick="ordenar('h_nom')">Nombre</th>
                <th onclick="ordenar('h_num_hab')">Habitación</th>
                <th onclick="ordenar('hotel')">Hotel</th>


                <th>Tipo</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <div class="status-bar" id="statusMsg"></div>
</div>

<script>
    let reservasGlobal = [];
    let ordenActual = '';
    let ascendente = true;

    document.addEventListener("DOMContentLoaded", function () {

        cargarReservas();
        cargarImpresoras();

        document.getElementById("searchInput").addEventListener("input", filtrarTabla);
        document.getElementById("hotelFilter").addEventListener("change", filtrarTabla);
    });

    function cargarReservas() {
        fetch('/Tickets/GetReservasDia')
            .then(res => res.json())
            .then(data => {

                reservasGlobal = data;
                llenarFiltroHoteles(data);
                renderTabla(data);

                document.getElementById("contador").innerText = data.length + " reservas";
            });
    }

    function cargarImpresoras() {
        fetch('/Tickets/GetInstalledPrinters')
            .then(res => res.json())
            .then(data => {
                const select = document.getElementById("printerSelect");
                select.innerHTML = "";

                data.forEach(p => {
                    select.innerHTML += `<option value="${p}">${p}</option>`;
                });
            });
    }

    function renderTabla(data) {
        const tbody = document.querySelector("#tablaReservas tbody");
        tbody.innerHTML = "";

        data.forEach(r => {
            const row = `
        <tr>

            <td>${r.h_res_cve ?? ''}</td>
                <td>${r.h_cod_reserva ?? ''}</td> <!-- nueva columna -->
            <td>${r.h_nom ?? ''}</td>
            <td>${r.h_num_hab ?? ''}</td>
            <td><span class="badge">${r.hotel ?? ''}</span></td>
            <td>${r.h_tpo_hab ?? ''}</td>
            <td>
                <button class="btn-print" onclick="imprimir(
                    '${r.h_res_cve}',
                    '${r.h_nom}',
                    '${r.h_num_hab}',
                    '${r.hotel}'
                )">
                    Imprimir
                </button>
            </td>
        </tr>`;
            tbody.innerHTML += row;
        });
    }

    function llenarFiltroHoteles(data) {
        const hoteles = [...new Set(data.map(r => r.hotel).filter(Boolean))];
        const select = document.getElementById("hotelFilter");

        hoteles.forEach(h => {
            select.innerHTML += `<option value="${h}">${h}</option>`;
        });
    }

    function filtrarTabla() {
        const texto = document.getElementById("searchInput").value.toLowerCase();
        const hotel = document.getElementById("hotelFilter").value;

        const filtradas = reservasGlobal.filter(r => {

            const coincideTexto =
                (r.h_nom ?? '').toLowerCase().includes(texto) ||
                (r.h_res_cve ?? '').toLowerCase().includes(texto) ||
                (r.h_num_hab ?? '').toLowerCase().includes(texto) ||
                (r.h_cod_reserva ?? '').toLowerCase().includes(texto); // <-- agregamos TSW
;

            const coincideHotel = hotel === "" || r.hotel === hotel;

            return coincideTexto && coincideHotel;
        });

        renderTabla(filtradas);
        document.getElementById("contador").innerText = filtradas.length + " reservas";
    }

    function ordenar(campo) {
        ascendente = ordenActual === campo ? !ascendente : true;
        ordenActual = campo;

        reservasGlobal.sort((a, b) => {
            const valA = a[campo] ?? '';
            const valB = b[campo] ?? '';
            return ascendente
                ? valA.localeCompare(valB)
                : valB.localeCompare(valA);
        });

        renderTabla(reservasGlobal);
    }

    function imprimir(folio, name, room, hotel) {

        const printer = document.getElementById("printerSelect").value;

        fetch('/Tickets/PrintTicket', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                folio: folio,
                name: name,
                room: room,
                hotel: hotel,
                printer: printer,
                comments: "" // si no tienes txtComentarios
            })
        })
            .then(res => res.json())
            .then(resp => {
                const status = document.getElementById("statusMsg");

                if (resp.success) {
                    status.innerHTML = "✔ Ticket enviado correctamente";
                    status.style.color = "green";
                } else {
                    status.innerHTML = "✖ Error: " + resp.message;
                    status.style.color = "red";
                }
            });
    }

</script>
