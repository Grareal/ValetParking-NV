@model IEnumerable<AppValetParking.Models.Usuario>
@{ Layout = null; }
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Usuarios</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><style>:root{--blue:#2f6ea3;--teal:#5cc6b7;--gold:#b98a4a;--ink:#2c3e50}body{margin:0;min-height:100vh;padding:32px 15px;background:#eef3f6;font-family:'Segoe UI',sans-serif;color:var(--ink)}.hero,.panel{max-width:1180px;margin:auto}.hero{background:linear-gradient(135deg,var(--blue),var(--teal));padding:28px;border-radius:18px 18px 0 0;color:#fff}.panel{background:#fff;padding:26px;border-radius:0 0 18px 18px;box-shadow:0 18px 50px #20304020}.btn-new{background:var(--gold);color:#fff}.badge-role{background:#e8f4f2;color:#245f66;padding:6px 9px;border-radius:20px;font-weight:600}.search{max-width:360px}.table-wrap{overflow:auto}th{color:var(--blue)}td{vertical-align:middle}.user{font-weight:700}.name{font-size:12px;color:#77838e}</style></head><body><header class="hero d-flex justify-content-between align-items-center gap-3 flex-wrap"><div><h1 class="h3 mb-1">Administracion de usuarios</h1><span>Colaboradores, roles y accesos de Valet Parking</span></div><div><a class="btn btn-light" href="/Dashboard/Index">Panel</a> <a class="btn btn-new" href="/Usuarios/Crear">+ Nuevo usuario</a></div></header><main class="panel"><div class="d-flex justify-content-between mb-3 gap-2 flex-wrap"><h2 class="h5">Usuarios registrados</h2><input id="buscar" class="form-control search" placeholder="Buscar usuario, nombre o gafete"/></div><div class="table-wrap"><table class="table table-hover" id="tabla"><thead><tr><th>Usuario / colaborador</th><th>Gafete</th><th>Rol</th><th class="text-end">Acciones</th></tr></thead><tbody>@foreach(var u in Model){var etiqueta=u.Funciones switch{"OperadoraValet"=>"Operadora / Valet","Administracion"=>"Administradores","TI"=>"TI",_=>u.Funciones};<tr><td><div class="user">@u.Username</div><div class="name">@(u.Nombre ?? "Sin nombre registrado")</div></td><td>@(u.Gafete ?? "-")</td><td><span class="badge-role">@etiqueta</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/Usuarios/Editar/@u.Id">Editar</a> <a class="btn btn-sm btn-outline-danger" href="/Usuarios/Eliminar/@u.Id" onclick="return confirm('Eliminar este usuario?')">Eliminar</a></td></tr>}</tbody></table></div><div id="vacio" class="text-center text-secondary py-3 d-none">No se encontraron usuarios.</div></main><script>const q=document.getElementById('buscar'),rows=[...document.querySelectorAll('#tabla tbody tr')],empty=document.getElementById('vacio');q.addEventListener('input',()=>{let count=0;rows.forEach(r=>{const show=r.innerText.toLowerCase().includes(q.value.toLowerCase().trim());r.hidden=!show;if(show)count++});empty.classList.toggle('d-none',count>0)});</script></body></html>
