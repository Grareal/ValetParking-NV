@model AppValetParking.Models.Usuario
@{
    Layout = null;
    var roles = ViewBag.Roles as (string Clave, string Etiqueta, string Descripcion)[]
        ?? Array.Empty<(string, string, string)>();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Crear Usuario · Valet Parking</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --vidanta-teal: #5cc6b7;
            --vidanta-blue: #2f6ea3;
            --vidanta-gold: #b98a4a;
            --vidanta-gold-dark: #8c6535;
            --vidanta-ink: #2c3e50;
        }

        * { box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }

        body {
            margin: 0;
            min-height: 100vh;
            background: linear-gradient(135deg, var(--vidanta-blue), var(--vidanta-teal));
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
        }

        .layout {
            display: flex;
            gap: 30px;
            width: 100%;
            max-width: 1100px;
            align-items: stretch;
        }

        .card-panel {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 25px 60px rgba(0,0,0,.25), 0 5px 20px rgba(0,0,0,.08);
            padding: 32px;
        }

        .card-form { flex: 1 1 62%; }
        .card-guide { flex: 1 1 38%; }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 6px;
        }

        .brand-badge {
            width: 44px; height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--vidanta-gold), var(--vidanta-gold-dark));
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 22px;
        }

        h1 { font-size: 24px; font-weight: 700; color: var(--vidanta-ink); margin: 0; }
        .subtitle { color: #7b8794; font-size: 13px; margin: 0 0 24px 56px; }

        /* Buscador principal */
        .buscador-box {
            background: #f4f9f8;
            border: 1px solid #d9ece8;
            border-radius: 14px;
            padding: 18px;
            margin-bottom: 22px;
        }

        .buscador-title {
            font-weight: 700; color: var(--vidanta-blue);
            font-size: 14px; margin-bottom: 4px;
            display: flex; align-items: center; gap: 6px;
        }
        .buscador-help { font-size: 12px; color: #7b8794; margin-bottom: 12px; }

        .search-row { display: flex; gap: 10px; }
        .search-row input { flex: 1; }

        label { font-weight: 600; color: #55606b; font-size: 13px; margin-bottom: 5px; display: block; }

        .form-control {
            border-radius: 10px;
            border: 1px solid #d7dde3;
            padding: 11px 13px;
            font-size: 14px;
            width: 100%;
        }
        .form-control:focus {
            outline: none;
            border-color: var(--vidanta-teal);
            box-shadow: 0 0 0 3px rgba(92,198,183,.25);
        }
        .form-control[readonly] { background: #f6f8fa; color: #566; }

        .field { margin-bottom: 16px; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

        .resultados {
            margin-top: 8px;
            background: #fff;
            border: 1px solid #e2e8ee;
            border-radius: 10px;
            max-height: 190px;
            overflow: auto;
            display: none;
        }
        .resultados.show { display: block; }
        .resultado-item {
            padding: 10px 12px;
            cursor: pointer;
            border-bottom: 1px solid #f0f3f6;
            font-size: 13px;
        }
        .resultado-item:last-child { border-bottom: none; }
        .resultado-item:hover { background: #f4f9f8; }
        .resultado-item b { color: var(--vidanta-blue); }
        .resultado-item small { color: #8a949e; }
        .resultado-empty { padding: 12px; color: #a0a8b0; font-size: 13px; text-align: center; }

        /* Roles */
        .roles-title { font-weight: 700; color: var(--vidanta-ink); margin: 8px 0 12px; font-size: 15px; }
        .rol-card {
            display: flex; gap: 12px; align-items: flex-start;
            border: 1.5px solid #e2e8ee; border-radius: 12px;
            padding: 12px 14px; margin-bottom: 10px; cursor: pointer;
            transition: .18s;
        }
        .rol-card:hover { border-color: var(--vidanta-teal); }
        .rol-card input { margin-top: 3px; width: 17px; height: 17px; accent-color: var(--vidanta-blue); }
        .rol-card .rol-name { font-weight: 700; color: var(--vidanta-ink); font-size: 14px; }
        .rol-card .rol-desc { color: #7b8794; font-size: 12px; }
        .rol-card.checked { border-color: var(--vidanta-blue); background: #f2f8fc; }

        .btn-guardar {
            width: 100%; margin-top: 18px;
            padding: 13px; border: none; border-radius: 12px;
            font-weight: 700; font-size: 15px; color: #fff;
            background: linear-gradient(135deg, var(--vidanta-gold), var(--vidanta-gold-dark));
            cursor: pointer; transition: .2s;
        }
        .btn-guardar:hover { filter: brightness(1.05); transform: translateY(-1px); }
        .btn-volver {
            display: inline-block; margin-top: 10px; text-align: center; width: 100%;
            color: var(--vidanta-blue); text-decoration: none; font-size: 13px; font-weight: 600;
        }

        /* Guía */
        .card-guide h2 { font-size: 17px; color: var(--vidanta-ink); margin: 0 0 16px; }
        .guide-item {
            background: #f6f8fa; border-radius: 12px; padding: 14px; margin-bottom: 12px;
            border-left: 4px solid var(--vidanta-teal);
        }
        .guide-item b { color: var(--vidanta-blue); display: block; font-size: 14px; }
        .guide-item span { color: #7b8794; font-size: 12px; }

        @@media (max-width: 900px) {
            .layout { flex-direction: column; }
            .grid-2 { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="layout">
        <!-- FORM -->
        <div class="card-panel card-form">
            <div class="brand">
                <div class="brand-badge">👤</div>
                <h1>Crear Usuario</h1>
            </div>
            <p class="subtitle">Busca al colaborador y el sistema completa usuario, nombre y gafete.</p>

            <form method="post" id="formUsuario">
                <!-- BUSCADOR PRINCIPAL -->
                <div class="buscador-box">
                    <div class="buscador-title">🔎 Buscar por número de colaborador</div>
                    <div class="buscador-help">Ej.: escribe <b>53226</b> y se mapea a <b>OTH53226</b>, nombre y gafete.</div>
                    <div class="search-row">
                        <input type="text" id="buscadorNumero" class="form-control" inputmode="numeric"
                               placeholder="Número de colaborador (ej. 53226)" autocomplete="off" />
                    </div>
                    <div id="resultadosNumero" class="resultados"></div>

                    <div style="margin-top:12px">
                        <label style="font-size:12px">¿No sabes el número? Busca por apellido</label>
                        <input type="text" id="buscadorNombre" class="form-control"
                               placeholder="Apellido del colaborador…" autocomplete="off" />
                        <div id="resultadosNombre" class="resultados"></div>
                    </div>
                </div>

                <div class="grid-2">
                    <div class="field">
                        <label>Usuario</label>
                        <input asp-for="Username" id="username" class="form-control" placeholder="Se completa al elegir" />
                    </div>
                    <div class="field">
                        <label>Password</label>
                        <input asp-for="Password" id="password" type="text" class="form-control" placeholder="Contraseña" />
                    </div>
                </div>

                <div class="field">
                    <label>Nombre del colaborador</label>
                    <input asp-for="Nombre" id="nombre" class="form-control" placeholder="Se completa al elegir" />
                </div>

                <div class="field">
                    <label>Gafete</label>
                    <input asp-for="Gafete" id="gafete" class="form-control" placeholder="Se completa al elegir" />
                </div>

                <div class="roles-title">Rol del usuario</div>
                @foreach (var r in roles)
                {
                    <label class="rol-card">
                        <input type="radio" name="permisos" value="@r.Clave" required />
                        <span>
                            <span class="rol-name">@r.Etiqueta</span><br />
                            <span class="rol-desc">@r.Descripcion</span>
                        </span>
                    </label>
                }

                <button type="submit" class="btn-guardar">Guardar Usuario</button>
                <a class="btn-volver" href="/Usuarios/Index">← Volver al listado</a>
            </form>
        </div>

        <!-- GUÍA -->
        <div class="card-panel card-guide">
            <h2>Guía de roles</h2>
            <div class="guide-item"><b>📞 Operadora / Valet</b><span>Solicitudes, control, registros, reportes y tickets del día a día.</span></div>
            <div class="guide-item"><b>🛡️ Administradores</b><span>Acceso total al panel de Valet Parking.</span></div>
            <div class="guide-item"><b>💻 TI</b><span>Acceso total + configuración de vistas, impresoras y accesos.</span></div>
            <div class="guide-item" style="border-left-color:var(--vidanta-gold)">
                <b>💡 Tip</b><span>Los accesos de cada rol se configuran en <b>Configuración de Accesos</b> sin tocar código.</span>
            </div>
        </div>
    </div>

    <script>
        const $ = id => document.getElementById(id);

        function pintar(cont, data, onPick) {
            if (!data.length) { cont.innerHTML = '<div class="resultado-empty">Sin resultados</div>'; cont.classList.add('show'); return; }
            cont.innerHTML = data.map((e, i) => `
                <div class="resultado-item" data-i="${i}">
                    <b>${e.usuario}</b> · ${e.nombre || '(sin nombre)'}<br>
                    <small>N° ${e.numero} · Gafete ${e.gafete || '—'}</small>
                </div>`).join('');
            cont.classList.add('show');
            cont.querySelectorAll('.resultado-item').forEach(el =>
                el.onclick = () => { onPick(data[+el.dataset.i]); cont.classList.remove('show'); });
        }

        function seleccionar(e) {
            $('username').value = e.usuario || '';
            $('nombre').value = e.nombre || '';
            $('gafete').value = e.gafete || '';
            $('buscadorNumero').value = e.numero || '';
            $('buscadorNombre').value = '';
        }

        let t1;
        $('buscadorNumero').addEventListener('input', function () {
            clearTimeout(t1);
            const v = this.value.trim();
            if (v.length < 1) { $('resultadosNumero').classList.remove('show'); return; }
            t1 = setTimeout(() => {
                fetch('/Usuarios/BuscarPorColaborador?numero=' + encodeURIComponent(v))
                    .then(r => r.json())
                    .then(d => pintar($('resultadosNumero'), d, seleccionar));
            }, 250);
        });

        let t2;
        $('buscadorNombre').addEventListener('input', function () {
            clearTimeout(t2);
            const v = this.value.trim();
            if (v.length < 2) { $('resultadosNombre').classList.remove('show'); return; }
            t2 = setTimeout(() => {
                fetch('/Usuarios/BuscarEmpleado?term=' + encodeURIComponent(v))
                    .then(r => r.json())
                    .then(d => pintar($('resultadosNombre'), d, seleccionar));
            }, 300);
        });

        // Resaltar rol seleccionado
        document.querySelectorAll('.rol-card input').forEach(chk => {
            const sync = () => chk.closest('.rol-card').classList.toggle('checked', chk.checked);
            chk.addEventListener('change', () => {
                document.querySelectorAll('.rol-card input').forEach(item =>
                    item.closest('.rol-card').classList.toggle('checked', item.checked));
            });
            sync();
        });
    </script>
</body>
</html>
