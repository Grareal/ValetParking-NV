@model AppValetParking.Models.Usuario
@{ Layout = null; var roles = ViewBag.Roles as (string Clave, string Etiqueta, string Descripcion)[] ?? Array.Empty<(string,string,string)>(); var asignados = ViewBag.RolesAsignados as string[] ?? Array.Empty<string>(); }
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Editar usuario</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><style>:root{--blue:#2f6ea3;--teal:#5cc6b7;--gold:#b98a4a;--ink:#2c3e50}body{margin:0;min-height:100vh;padding:28px 15px;background:linear-gradient(135deg,var(--blue),var(--teal));font-family:'Segoe UI',sans-serif}.card{max-width:820px;margin:auto;border:0;border-radius:18px;padding:32px;box-shadow:0 24px 60px #0004}h1{color:var(--ink)}.search{padding:16px;background:#f2f8f7;border-radius:12px;margin:20px 0}.results{display:none;border:1px solid #ddd;border-radius:8px;max-height:160px;overflow:auto}.results.show{display:block}.result{padding:9px;cursor:pointer;border-bottom:1px solid #eee}.roles{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:18px 0}.role{border:1px solid #dbe3e8;border-radius:10px;padding:12px}.btn-save{background:linear-gradient(135deg,var(--gold),#8c6535);color:#fff}@@media(max-width:700px){.roles{grid-template-columns:1fr}}</style></head><body><main class="card"><h1 class="h3">Editar usuario</h1><p class="text-secondary">Actualiza al colaborador y asigna uno de los tres roles.</p><form method="post"><input type="hidden" name="id" value="@Model.Id"/><div class="search"><label class="form-label fw-semibold">Buscar otro colaborador por numero</label><input id="numero" class="form-control" inputmode="numeric" placeholder="Ej. 53226"/><div id="resultados" class="results"></div></div><div class="row g-3"><div class="col-md-6"><label>Usuario</label><input id="username" class="form-control" name="username" value="@Model.Username" required/></div><div class="col-md-6"><label>Password</label><input class="form-control" name="password" value="@Model.Password" required/></div><div class="col-md-8"><label>Nombre</label><input id="nombre" class="form-control" name="nombre" value="@Model.Nombre"/></div><div class="col-md-4"><label>Gafete</label><input id="gafete" class="form-control" name="gafete" value="@Model.Gafete"/></div></div><div class="roles">@foreach(var r in roles){<label class="role"><input type="radio" name="permisos" value="@r.Clave" checked="@asignados.Contains(r.Clave)"/> <strong>@r.Etiqueta</strong><small class="d-block text-secondary">@r.Descripcion</small></label>}</div><button class="btn btn-save" type="submit">Guardar cambios</button> <a class="btn btn-outline-secondary" href="/Usuarios/Index">Cancelar</a></form></main><script>const n=document.getElementById('numero'),box=document.getElementById('resultados');let t;n.addEventListener('input',()=>{clearTimeout(t);const v=n.value.trim();if(!v){box.classList.remove('show');return}t=setTimeout(async()=>{const d=await fetch('/Usuarios/BuscarPorColaborador?numero='+encodeURIComponent(v)).then(r=>r.json());box.innerHTML=d.length?d.map((e,i)=>`<div class="result" data-i="${i}"><b>${e.usuario}</b> - ${e.nombre}<br><small>Gafete ${e.gafete||'-'}</small></div>`).join(''):'<div class="result">Sin resultados</div>';box.classList.add('show');box.querySelectorAll('[data-i]').forEach(x=>x.onclick=()=>{const e=d[+x.dataset.i];username.value=e.usuario;nombre.value=e.nombre;gafete.value=e.gafete;box.classList.remove('show')})},250)});</script></body></html>
