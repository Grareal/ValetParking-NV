@model IEnumerable<AppValetParking.Models.Usuario>
    @{
    Layout = null;
    }

    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Administración de Usuarios</title>

        <!-- Bootstrap -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

        <!-- DataTables -->
        <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
        <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css">

        <style>
            body {
                background: #f1f5f9;
                font-family: 'Segoe UI', sans-serif;
                padding: 30px 15px;
            }

            /* CONTENEDOR */
            .card-container {
                background: #ffffff;
                padding: 25px 30px;
                border-radius: 16px;
                box-shadow: 0 15px 40px rgba(0,0,0,0.08);
            }

            /* HEADER */
            .header-title {
                font-weight: 700;
                color: #0f172a;
            }

            .sub-title {
                font-size: 14px;
                color: #64748b;
            }

            /* BOTÓN PRINCIPAL */
            .btn-primary {
                background: #1d4ed8;
                border: none;
                border-radius: 10px;
                padding: 8px 18px;
                font-weight: 500;
                box-shadow: 0 5px 15px rgba(29, 78, 216, 0.3);
                transition: 0.2s ease;
            }

                .btn-primary:hover {
                    background: #1e40af;
                    transform: translateY(-1px);
                }

            /* BOTONES ACCIÓN */
            .btn-warning {
                background: #f59e0b;
                border: none;
                border-radius: 8px;
                color: white;
            }

                .btn-warning:hover {
                    background: #d97706;
                }

            .btn-danger {
                background: #ef4444;
                border: none;
                border-radius: 8px;
            }

                .btn-danger:hover {
                    background: #dc2626;
                }

            /* TABLA */
            table.dataTable {
                border-radius: 12px;
                overflow: hidden;
            }

                table.dataTable thead {
                    background: #0f172a;
                    color: #fff;
                }

                    table.dataTable thead th {
                        border: none;
                        text-align: center;
                        font-weight: 600;
                    }

                table.dataTable tbody td {
                    text-align: center;
                    padding: 12px;
                }

                table.dataTable tbody tr {
                    transition: 0.2s;
                }

                    table.dataTable tbody tr:hover {
                        background: #f8fafc;
                    }

            /* BUSCADOR */
            .dataTables_filter input {
                border-radius: 10px;
                border: 1px solid #cbd5e1;
                padding: 6px 12px;
                outline: none;
            }

                .dataTables_filter input:focus {
                    border-color: #2563eb;
                    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
                }

            /* SELECT */
            .dataTables_length select {
                border-radius: 10px;
                padding: 5px;
            }

            /* PAGINACIÓN */
            .dataTables_paginate .paginate_button {
                border-radius: 8px !important;
                margin: 2px;
            }

                .dataTables_paginate .paginate_button.current {
                    background: #1d4ed8 !important;
                    color: white !important;
                    border: none;
                }

            /* RESPONSIVE */
            @@media (max-width: 768px) {
                .header-box {
                    flex-direction: column;
                    align-items: flex-start !important;
                    gap: 10px;
                }
            }
        </style>
    </head>

    <body>

        <div class="container">
            <div class="card-container">

                <!-- HEADER -->
                <div class="d-flex justify-content-between align-items-center mb-4 header-box">
                    <div>
                        <h3 class="header-title mb-0">Administración de Usuarios</h3>
                        <span class="sub-title">Gestiona accesos y permisos del sistema</span>
                    </div>

                    <a class="btn btn-primary" href="/Usuarios/Crear">
                        + Nuevo Usuario
                    </a>
                </div>

                <!-- TABLA -->
                <table id="usuariosTable" class="table table-bordered nowrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Usuario</th>
                            <th>Password</th>
                            <th>Gafete</th>
                            <th>Permisos</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.Id</td>
                            <td>@u.Username</td>

                            <!-- IMPORTANTE: NO MOSTRAR PASSWORD -->
                            <td>••••••••</td>
                            <td>@u.Gafete</td>

                            <td>@u.Funciones</td>

                            <td>
                                <a class="btn btn-warning btn-sm" href="/Usuarios/Editar/@u.Id">
                                    Editar
                                </a>

                                <a class="btn btn-danger btn-sm"
                                   href="/Usuarios/Eliminar/@u.Id"
                                   onclick="return confirm('¿Eliminar usuario?')">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>

            </div>
        </div>

        <!-- LIBRERÍAS -->
        <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

        <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
        <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

        <script>
            $(document).ready(function () {
                $('#usuariosTable').DataTable({
                    responsive: true,
                    pageLength: 10,
                    lengthMenu: [5, 10, 25, 50],
                    language: {
                        search: "Buscar:",
                        lengthMenu: "Mostrar _MENU_ usuarios",
                        info: "Mostrando _START_ a _END_ de _TOTAL_ usuarios",
                        paginate: {
                            first: "Primera",
                            last: "Última",
                            next: "Siguiente",
                            previous: "Anterior"
                        },
                        zeroRecords: "No se encontraron usuarios"
                    }
                });
            });
        </script>

    </body>
</html>
