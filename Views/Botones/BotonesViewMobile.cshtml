@model AppValetParking.Models.ValetRegistro

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Registro Valet - Móvil</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg,#0f172a,#1e293b);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .container {
            background: white;
            width: 100%;
            max-width: 480px;
            border-radius: 18px;
            padding: 1.8rem;
            box-shadow: 0 20px 40px rgba(0,0,0,.25), 0 6px 12px rgba(0,0,0,.15);
        }

        h1.title {
            text-align: center;
            margin-bottom: 1.8rem;
            font-weight: 700;
            font-size: 1.7rem;
            color: #0f172a;
        }


        form {
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
        }


        .row-inline {
            display: flex;
            gap: 0.8rem;
        }

            .row-inline > div {
                flex: 1;
            }

        label {
            font-size: .85rem;
            font-weight: 600;
            color: #475569;
        }


        input[type="text"],
        input[type="number"],
        select {
            width: 100%;
            padding: 0.9rem 1rem;
            font-size: 1.1rem;
            border-radius: 8px;
            border: 1.5px solid #ced4da;
            transition: border-color 0.3s ease;
        }

        input[readonly] {
            background: #f1f5f9;
        }

        input[type="text"]:focus,
        input[type="number"]:focus,
        select:focus {
            border-color: #0d6efd;
            outline: none;
            box-shadow: 0 0 6px rgba(13, 110, 253, 0.4);
        }

        .form-control.error {
            border-color: #dc3545 !important;
            background-color: #f8d7da;
        }

        button.btn-submit {
            margin-top: .5rem;
            background: linear-gradient(135deg,#2563eb,#1d4ed8);
            color: white;
            border: none;
            padding: 1rem;
            border-radius: 12px;
            font-size: 1.2rem;
            font-weight: 600;
            cursor: pointer;
            transition: .2s;
        }

        input:focus, select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,.2);
            outline: none;
        }

            button.btn-submit:hover {
                transform: translateY(-1px);
                box-shadow: 0 10px 20px rgba(37,99,235,.3);
            }

        .mensaje-confirmacion {
            margin-top: 1rem;
            padding: .8rem;
            background: #dcfce7;
            color: #166534;
            border-radius: 8px;
            text-align: center;
            font-weight: 600;
        }

        input, select {
            width: 100%;
            padding: 0.9rem;
            border-radius: 10px;
            border: 1.5px solid #cbd5e1;
            font-size: 1rem;
            transition: .2s;
        }

        body {
            padding-top: env(safe-area-inset-top);
            padding-left: env(safe-area-inset-left);
            padding-right: env(safe-area-inset-right);
            padding-bottom: env(safe-area-inset-bottom);
        }
    </style>
</head>
<body>
    <div class="container">
        <h1 class="title">Registro Valet Parking</h1>
        <form asp-controller="Botones" asp-action="Index" method="post" novalidate>
            <div class="row-inline">
                <div>
                    <label for="FolioVP">Folio</label>
                    <input type="text" id="FolioVP" name="FolioVP" class="form-control" autocomplete="off" />
                </div>
                <div>
                    <label for="Reserva">Reserva</label>
                    <input type="number" id="Reserva" name="Reserva" class="form-control" autocomplete="off" />
                </div>
            </div>

            <div class="row-inline">
                <div>
                    <label for="Hotel">Hotel</label>
                    <input type="text" id="Hotel" readonly class="form-control" />
                </div>

                <div>
                    <label for="Habitacion">Habitación</label>
                    <input type="text" id="Habitacion" readonly class="form-control" />
                </div>
            </div>

            <div>
                <label for="NumeroOperadorInput">Numero del operador</label>
                <input type="text" id="NumeroOperadorInput" name="NumeroOperador" class="form-control" autocomplete="off" />
            </div>

            <div>
                <label for="ValetNombreInput">Valet</label>
                <input type="text" id="ValetNombreInput" name="Valet" class="form-control" />
                <input type="hidden" id="ValetNombreHidden" name="ValetNombreHidden" />
            </div>

            <div class="form-group">
                <label for="Servicio">Servicio</label>
                <select id="Servicio" name="Servicio" class="form-control" required></select>
            </div>

            <button type="submit" class="btn-submit">Guardar</button>
        </form>

        @if (ViewBag.Mensaje != null)
        {
        <div class="mensaje-confirmacion" role="alert">
            @ViewBag.Mensaje
        </div>
        }
    </div>

    <button onclick="activarPantallaCompleta()" style="display:none;" id="btnFullscreen">Pantalla completa</button>

    <script>
        function activarPantallaCompleta() {
            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen();
            } else if (document.documentElement.webkitRequestFullscreen) {
                document.documentElement.webkitRequestFullscreen(); // Safari
            } else if (document.documentElement.msRequestFullscreen) {
                document.documentElement.msRequestFullscreen(); // IE11
            }
        }
    </script>

    <script src="~/js/registro.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const folioInput = document.getElementById('FolioVP');
            const reservaInput = document.getElementById('Reserva');
            const numeroInput = document.getElementById('NumeroOperadorInput');
            const btnGuardar = document.querySelector('button[type="submit"]');
            const form = document.querySelector('form');
            const valetNombreVisible = document.getElementById('ValetNombreInput');

            function esMobile() {
                return window.innerWidth <= 768;
            }

            if (esMobile()) {
                folioInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        reservaInput.focus();
                    }
                });

                reservaInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        numeroInput.focus();
                    }
                });

                numeroInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        btnGuardar.click();
                    }
                });
            }

            form.addEventListener('submit', () => {
                // Guardar valor visible de Valet
            });
        });
    </script>

    <!-- MODO RAFAGA -->
    <div style="display:none;">
        <label>
            <input type="checkbox" id="chkModoRafaga" />
            Modo Ráfaga
        </label>
    </div>
    <script>
        // Guardar checkbox en localStorage
        const chkRafaga = document.getElementById('chkModoRafaga');
        chkRafaga.checked = localStorage.getItem('modoRafaga') === 'true';
        chkRafaga.addEventListener('change', () => {
            localStorage.setItem('modoRafaga', chkRafaga.checked);
        });

        // Inicializar modo ráfaga
        fetch('/Config/configuracionValet.json')
            .then(response => response.json())
            .then(config => {
                const modoRafaga = JSON.parse(localStorage.getItem('modoRafaga') || 'false');
                if (modoRafaga) inicializarModoRafaga(config.cantidadDisparos, config.identificadores);
            });

        function inicializarModoRafaga(cantidadDisparos, identificadores) {
            let bufferTemporal = {};
            document.addEventListener('keydown', function (event) {
                if (!/^[a-zA-Z0-9]$/.test(event.key)) return;
                if (!window.scanBuffer) window.scanBuffer = '';
                window.scanTimeout && clearTimeout(window.scanTimeout);
                window.scanBuffer += event.key;
                window.scanTimeout = setTimeout(() => {
                    procesarEntrada(window.scanBuffer);
                    window.scanBuffer = '';
                }, 250);
            });

            function procesarEntrada(data) {
                if (!data) return;
                const scanUpper = data.toUpperCase();
                for (const campo in identificadores) {
                    const prefijo = identificadores[campo].toUpperCase();
                    if (scanUpper.startsWith(prefijo)) {
                        bufferTemporal[campo] = data.substring(prefijo.length);
                        break;
                    }
                }
                if (Object.keys(bufferTemporal).length >= cantidadDisparos) {
                    asignarCamposDesdeBuffer(bufferTemporal);
                    bufferTemporal = {};
                }
            }

            function asignarCamposDesdeBuffer(datos) {

                const mapping = {
                    "FOLIO": "FolioVP",
                    "RESERVA": "Reserva",
                    "NUMEROOPERADOR": "NumeroOperadorInput",
                    "UBICACION": "Servicio"
                };

                for (const campo in datos) {

                    const inputId = mapping[campo.toUpperCase()];
                    if (!inputId) continue;

                    const input = document.getElementById(inputId);
                    if (!input) continue;

                    input.value = datos[campo];



                    if (campo.toUpperCase() === "RESERVA") {
                        window.actualizarDatosReserva(datos[campo]);
                    }

                    if (campo.toUpperCase() === "NUMEROOPERADOR") {

                        input.dispatchEvent(new Event('input')); 


                    }
                }

                const ubicacionDefault = localStorage.getItem('ubicacionPorDefecto') || 'ANDENES';
                const selectServicio = document.getElementById('Servicio');
                if (selectServicio) selectServicio.value = ubicacionDefault;
            }
        }
    </script>

    <script src="@Url.Content("~/js/serviciosvp.js")"></script>
    <script>
        cargarOpcionesServicio('Servicio', '/Config/servicios.json', '@Model?.Servicio');
    </script>

</body>
</html>
