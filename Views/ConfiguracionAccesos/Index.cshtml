@model IReadOnlyList<AppValetParking.Models.VistaSistema>
@{ Layout = null; }
<!doctype html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Configuracion de accesos</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<style>:root{--blue:#2f6ea3;--teal:#5cc6b7;--gold:#b98a4a;--ink:#2c3e50}body{margin:0;min-height:100vh;padding:32px 16px;background:linear-gradient(135deg,var(--blue),var(--teal));font-family:'Segoe UI',sans-serif;color:var(--ink)}.panel{max-width:1250px;margin:auto;background:#fff;border-radius:18px;padding:28px;box-shadow:0 24px 60px #0004}h1{font-size:25px;margin:0}.hint{color:#667788;margin:6px 0 22px}.table-wrap{overflow:auto}th{white-space:nowrap;background:var(--blue)!important;color:white!important}.form-control{min-width:115px}.url{min-width:220px}.btn-save{background:linear-gradient(135deg,var(--gold),#8c6535);color:#fff;border:0}.ok{padding:10px;background:#d1e7dd;border-radius:8px;margin-bottom:16px}</style></head>
<body><main class="panel"><div class="d-flex justify-content-between align-items-start gap-3 flex-wrap"><div><h1>Configuracion de vistas y accesos</h1><p class="hint">TI puede cambiar el menu y el acceso real de Operadora / Valet. Administradores y TI conservan acceso total.</p></div><a href="/Dashboard/Index" class="btn btn-outline-secondary">Volver</a></div>
@if (TempData["Ok"] != null) { <div class="ok">@TempData["Ok"]</div> }
<form method="post" action="/ConfiguracionAccesos/Guardar">@Html.AntiForgeryToken()<div class="table-wrap"><table class="table table-striped align-middle"><thead><tr><th>Titulo</th><th>Icono</th><th>URL protegida</th><th>Orden</th><th>Activo</th><th>Menu</th><th>Operadora / Valet</th></tr></thead><tbody>
@foreach (var vista in Model) { <tr><td><input type="hidden" name="ids" value="@vista.Id" /><input class="form-control" name="titulos" value="@vista.Titulo" required /></td><td><input class="form-control" name="iconos" value="@vista.Icono" maxlength="30" /></td><td><input class="form-control url" name="urls" value="@vista.Url" required /></td><td><input class="form-control" type="number" name="ordenes" value="@vista.Orden" /></td><td><input class="form-check-input" type="checkbox" name="activos" value="@vista.Id" checked="@vista.Activo" /></td><td><input class="form-check-input" type="checkbox" name="menus" value="@vista.Id" checked="@vista.MostrarEnMenu" /></td><td><input class="form-check-input" type="checkbox" name="operadora" value="@vista.Id" checked="@vista.Roles.Any(r => r.Rol == "OperadoraValet")" /></td></tr> }
</tbody></table></div><button class="btn btn-save px-4 py-2" type="submit">Guardar configuracion</button></form></main></body></html>
